# Copy this file to `.env` and fill in your values. Never commit `.env` to git.
# python-decouple (config()) reads these from `.env` in the `backend/` directory.
# See docs/TECHNICAL_SPEC.md section 10 for the full settings reference.

# --- Django core ---
# No default in settings — the app crashes on startup if this is missing.
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to True only in local development.
DEBUG=False

# Comma-separated host/domain names that are allowed to serve the app.
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.10

# --- Database (MySQL) ---
# No defaults in settings — the app crashes on startup if these are missing.
DB_NAME=lms_db
DB_USER=lms_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=3306

# --- CORS ---
# Comma-separated list of frontend origins allowed to call the API.
# prod.py reads this from the environment first, then falls back to this .env value.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://192.168.1.10:3000

# --- Frontend ---
# Base URL the frontend uses to reach the backend (used for password-reset links).
FRONTEND_URL=http://localhost:3000

# --- Email (Gmail SMTP) ---
# SMTP host/port/TLS are fixed in settings/base.py (smtp.gmail.com:587).
# Use a Gmail App Password, not the account password.
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_APP_PASSWORD=your-gmail-app-password
